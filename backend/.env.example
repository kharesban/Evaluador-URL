# Copia este archivo como .env para desarrollo local y completa tus propias claves.
# Nunca subas un archivo .env real a GitHub.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Si DATABASE_URL no está definida, el backend usa SQLite local.
# En Render, define DATABASE_URL como variable privada con la cadena de Neon.
# DATABASE_URL=
SQLITE_DB_PATH=evaluaciones.db

# El historial no se purga automáticamente. Solo cambia a 1 si deseas activar
# explícitamente la eliminación de evaluaciones con más de 24 horas.
ENABLE_TASK_CLEANUP=0
